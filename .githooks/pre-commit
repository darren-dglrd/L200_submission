#!/usr/bin/env bash
# ==============================================================================
# Phase 1: Pre-Merge Local Gate (.githooks/pre-commit)
# Design Principle: Agent Harness Engineering & 3-Phase CI/CD Pipeline
# (`Prototype to Production.pdf`, pp. 21-25)
# - Blocks raw confidential dataset (`data/raw_wafers.csv`) or leaked API keys
# - Runs deterministic unit & trajectory evaluation suite before every commit
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "[Agent Harness Pre-Commit] 1/2 Scanning staged files for raw confidential datasets & secrets..."
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM || true)"

for FILE in $STAGED_FILES; do
  if [[ "$FILE" == *"raw_wafers.csv"* ]] || [[ "$FILE" == *"unpivoted_wafer_events.csv"* ]]; then
    echo "ERROR: Attempted to commit raw un-obfuscated wafer dataset ($FILE). Blocked by Safety Gate."
    exit 1
  fi
  if [[ -f "$REPO_ROOT/$FILE" ]] && [[ "$FILE" != ".githooks/pre-commit" ]]; then
    if grep -Eq "(AIza[0-9A-Za-z_-]{35}|BEGIN (RSA |EC )?PRIVATE KEY)" "$REPO_ROOT/$FILE"; then
      echo "ERROR: Potential credential or private key detected in $FILE."
      exit 1
    fi
  fi
done

echo "[Agent Harness Pre-Commit] 2/2 Running Unit, Guardrail, A2UI v0.9 & Golden Trajectory Eval Suite..."
PYTHONPATH="$REPO_ROOT" python3 -m unittest discover -s "$REPO_ROOT/tests" -p "test_*.py" -q

echo "[Agent Harness Pre-Commit] All checks passed."
